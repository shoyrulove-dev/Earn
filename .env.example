# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pureearn?retryWrites=true&w=majority

# Optional Google OAuth (leave blank until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Webhook secrets - configure these before enabling production postbacks
ACCESSTRADE_WEBHOOK_SECRET=
TIMEWALL_WEBHOOK_SECRET=
CPALEAD_WEBHOOK_SECRET=

# Admin bootstrap email
ADMIN_EMAIL=admin@example.com
