# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-long-random-secret
NEXT_PUBLIC_APP_URL=http://localhost:3000

# MongoDB Atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/pureearn?retryWrites=true&w=majority

# Optional Google OAuth (leave blank until configured)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# AccessTrade Publisher API
ACCESSTRADE_API_KEY=
ACCESSTRADE_API_URL=https://api.accesstrade.vn
ACCESSTRADE_BLOCKED_CAMPAIGNS=

# PHT off-chain reward economy
PHT_USER_SHARE=0.50
PHT_PENDING_DAYS=5
VND_PER_USD=24000
CRON_SECRET=replace-with-a-long-random-secret

# Webhook secrets - configure these before enabling production postbacks
ACCESSTRADE_WEBHOOK_SECRET=
TIMEWALL_WEBHOOK_SECRET=
CPALEAD_WEBHOOK_SECRET=

# Admin bootstrap email
ADMIN_EMAIL=admin@example.com

# Telegram publishing (keep the bot token server-side only)
TELEGRAM_BOT_TOKEN=
TELEGRAM_NEWS_CHAT_ID=-1004353318290
TELEGRAM_COMMUNITY_CHAT_ID=-5467216486
